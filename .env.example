# 在项目根目录复制为 .env 后填入
OPENAI_API_KEY=

# 可选。走官方接口可留空；走代理时填写兼容 OpenAI 的地址
OPENAI_BASE_URL=

# 本机代理（Clash/V2Ray 等）
# 例如：HTTPS_PROXY=http://127.0.0.1:7897
HTTPS_PROXY=
OPENAI_PROXY=

# 全部模型走 gpt-5.6-luna
OPENAI_MODEL=gpt-5.6-luna

# 封面文生图模型
OPENAI_IMAGE_MODEL=gpt-image-1

# 封面右下角笔名印章
AUTHOR_PEN_NAME=龙龙老表

# none | low | medium | high | xhigh | max
OUTLINE_REASONING_EFFORT=medium
CHAPTER_REASONING_EFFORT=medium

# 单次请求超时（毫秒）
REQUEST_TIMEOUT_MS=480000

# 默认不自动出剧本；需要时设为 1，或 npm run script
AUTO_SCRIPT=0

# 封面生产关闭；需要时 COVER_ENABLED=1
COVER_ENABLED=0
AUTO_COVER=0
COVER_COUNT=1
OPENAI_IMAGE_QUALITY=low

# 短篇 token 上限（省钱且保质）
SHORT_OUTLINE_MAX_TOKENS=4500
SHORT_WRITE_MAX_TOKENS=24000
SHORT_CONTINUE_MAX_TOKENS=6000
SHORT_TIGHTEN_MAX_TOKENS=4000
CHAPTER_PRODUCE_MAX_ATTEMPTS=3
